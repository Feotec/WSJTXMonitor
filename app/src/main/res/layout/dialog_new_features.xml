<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:id="@+id/dialog_new_features_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialog_new_features_internal_constraint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/dialog_new_features_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/dialog_reply_desc"
                android:src="@drawable/baseline_reply_red_36"
                app:layout_constraintBottom_toBottomOf="@id/dialog_new_features_text1"
                app:layout_constraintStart_toStartOf="@id/dialog_new_features_text2"
                app:layout_constraintTop_toTopOf="@id/dialog_new_features_text1" />

            <TextView
                android:id="@+id/dialog_new_features_text1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="10dp"
                android:textColor="@color/displayAllTextMain"
                android:text="@string/new_features_text"
                android:textSize="17sp"
                app:layout_constraintBottom_toTopOf="@id/dialog_new_features_text2"
                app:layout_constraintStart_toEndOf="@id/dialog_new_features_image"
                app:layout_constraintEnd_toEndOf="@id/dialog_new_features_text2"
                app:layout_constraintTop_toTopOf="parent"
                />

            <!--
                Note - It seem that the view that the others are referenced to
                needs to have layout_width set to "wrap_content" instead of 0dp
                or else things go kind of stupid.

                In this case the above two start/end constraints are referenced to
                the below TextView.  However, it seems that the layout_margin*
                parameters are independent for each view.  That is, a margin defined
                for the below (reference) doesn't have any effect on the above Views.
            -->
            <TextView
                android:id="@+id/dialog_new_features_text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="10dp"
                android:textColor="@color/displayAllTextMain"
                android:text="@string/new_features_text2"
                android:textSize="17sp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dialog_new_features_text1"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
